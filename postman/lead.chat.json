            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/search?query=proposal&leadId={{leadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "proposal"
                },
                {
                  "key": "leadId",
                  "value": "{{leadId}}",
                  "disabled": true
                }
              ]
            }
          }
        },
