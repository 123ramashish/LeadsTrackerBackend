{
  "info": {
    "name": "LeadTracker API",
    "description": "Complete API collection for LeadTracker multi-company SaaS.\n\n## Setup\n1. Set `baseUrl` variable to your server (default: `http://localhost:3000`)\n2. Run **Init SuperAdmin** first, then **Login** to auto-populate tokens.\n3. Each role folder uses its own token variable (`superAdminToken`, `adminToken`, `userToken`).\n\n## Auto-token scripts\nLogin requests automatically save the token to the correct variable via Test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",        "value": "http://localhost:3000",  "type": "string" },
    { "key": "superAdminToken","value": "",                        "type": "string" },
    { "key": "adminToken",     "value": "",                        "type": "string" },
    { "key": "managerToken",   "value": "",                        "type": "string" },
    { "key": "userToken",      "value": "",                        "type": "string" },
    { "key": "companyId",      "value": "",                        "type": "string" },
    { "key": "userId",         "value": "",                        "type": "string" },
    { "key": "leadId",         "value": "",                        "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 Auth",
      "item": [

        {
          "name": "Init SuperAdmin (run once)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.user && r.user.id) {",
                "  pm.collectionVariables.set('userId', r.user.id);",
                "  console.log('SuperAdmin created:', r.user.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/superadmin/init", "host": ["{{baseUrl}}"], "path": ["api","auth","superadmin","init"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Super Admin\",\n  \"email\": \"superadmin@leadtracker.com\",\n  \"phone\": \"9000000000\",\n  \"password\": \"SuperAdmin@123\"\n}"
            }
          }
        },

        {
          "name": "Login – SuperAdmin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.accessToken) {",
                "  pm.collectionVariables.set('superAdminToken', r.accessToken);",
                "  console.log('SuperAdmin token saved');",
                "}",
                "pm.test('Login successful', () => pm.response.to.have.status(200));",
                "pm.test('Has accessToken', () => pm.expect(r.accessToken).to.be.a('string'));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"superadmin@leadtracker.com\",\n  \"password\": \"SuperAdmin@123\",\n  \"usePhone\": false\n}"
            }
          }
        },

        {
          "name": "Login – Admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.accessToken) {",
                "  pm.collectionVariables.set('adminToken', r.accessToken);",
                "  if (r.user && r.user.companyId) pm.collectionVariables.set('companyId', r.user.companyId);",
                "  console.log('Admin token saved');",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@acme.com\",\n  \"password\": \"Admin@123\",\n  \"usePhone\": false\n}"
            }
          }
        },

        {
          "name": "Login – User",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.accessToken) {",
                "  pm.collectionVariables.set('userToken', r.accessToken);",
                "  console.log('User token saved');",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"9876543212\",\n  \"password\": \"User@1234\",\n  \"usePhone\": true\n}"
            }
          }
        },

        {
          "name": "Login – Phone (usePhone: true)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"9000000000\",\n  \"password\": \"SuperAdmin@123\",\n  \"usePhone\": true\n}"
            }
          }
        },

        {
          "name": "Login – Wrong Password (expect 401)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Returns 401', () => pm.response.to.have.status(401));",
                "pm.test('Has attemptsLeft', () => {",
                "  const r = pm.response.json();",
                "  pm.expect(r).to.have.property('attemptsLeft');",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"superadmin@leadtracker.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },

        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/otp/request", "host": ["{{baseUrl}}"], "path": ["api","auth","otp","request"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@acme.com\",\n  \"forPasswordReset\": true\n}"
            }
          }
        },

        {
          "name": "Reset Password with OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/password/reset", "host": ["{{baseUrl}}"], "path": ["api","auth","password","reset"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@acme.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewAdmin@123\"\n}"
            }
          }
        },

        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","auth","logout"] }
          }
        }

      ]
    },

