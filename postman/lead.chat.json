    {
      "name": "Chat",
      "item": [
        {
          "name": "Send Message to Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"content\": \"Hello, following up on your inquiry.\",\n  \"fileUrls\": [\"https://example.com/file.pdf\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            }
          }
        },
        {
          "name": "Receive Message (Webhook)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"content\": \"I am interested in your services.\",\n  \"fileUrls\": [],\n  \"leadIdentifier\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/receive",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "receive"
              ]
            }
          }
        },
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/lead/{{leadId}}?page=1&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "lead",
                "{{leadId}}"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Mark Messages as Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/lead/{{leadId}}/mark-as-read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
